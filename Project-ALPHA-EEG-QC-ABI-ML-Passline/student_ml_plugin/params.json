{
  "model_version": "trimodel_eeg_qc_v1",
  "decision_temperature": 1.0,
  "reason_probability_cutoff": 0.5,
  "flatline_range_epsilon": 0.000001,
  "random_forest": {
    "n_estimators": 200,
    "class_weight": "balanced",
    "random_state": 42,
    "min_samples_leaf": 2,
    "n_jobs": -1,
    "imputer_strategy": "median"
  },
  "evaluation": {
    "train_split": "train",
    "validation_split": "val",
    "test_split": "test",
    "positive_label": 1,
    "negative_label": 0
  },
  "reason_cutoffs": {
    "AMP_RANGE": 500,
    "FLATLINE": 0.1,
    "ABNORMAL KURTOSIS": 3,
    "ABNORMAL SKEWNESS": 10,
    "EXCESSIVE LINE LENGTH": 20,
    "EXCESSIVE ZERO CROSSINGS": 0.4,
    "INSUFFICIENT CHANNELS": 1
  }
}
